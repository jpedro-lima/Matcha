# ── Postgres ─────────────────────────
POSTGRES_USER=matcha
POSTGRES_PASSWORD=changeme
POSTGRES_DB=matcha_db
# Use `localhost` so host-side scripts (npm run migrate, npm run dev) reach the
# postgres container via the published port. The api container overrides this
# to `db` via docker-compose.yml `environment:` block.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── API ──────────────────────────────
NODE_ENV=development
API_PORT=3000
APP_URL=https://localhost

# ── JWT ──────────────────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-another-strong-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── SMTP ─────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=no-reply@matcha.local
# Em true, o email-service só loga o conteúdo (com o URL+token) e não chama SMTP.
# Útil quando você não tem domínio verificado no provedor de email.
SMTP_DISABLED=false

# ── Object storage (MinIO via S3-compat) ────
# Credenciais root do MinIO — também usadas como S3_ACCESS_KEY/SECRET_KEY
# pela API. Trocar antes de subir em produção.
MINIO_ROOT_USER=matcha
MINIO_ROOT_PASSWORD=changeme-min-12-chars
# Endpoint S3-compat. Use `localhost:9000` para scripts host-side; o container
# da API recebe override `http://minio:9000` via docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=matcha-photos
S3_ACCESS_KEY=matcha
S3_SECRET_KEY=changeme-min-12-chars
# URL público (via nginx, cache 7d). Cliente recebe esse prefixo no `confirm`.
S3_PUBLIC_URL=https://localhost/uploads

# Limite de tamanho da foto (em MB) — validado no presign.
MAX_PHOTO_SIZE_MB=5
